      "review_reports": 87,
      "individual_findings_reviewed": "~900",
      "standalone_disclosures": 4,
      "named_historical_incidents": 8,
      "token_rugpull_bug_classes": 8
    },
    "stat_caveat": "Frequency/percentage claims in files 15-19 (e.g. '28% of Criticals', '$953M lost in 2024') are attributed to the source material they were extracted from, not independently verified by this KB's maintainers. Treat them as a claimed prior, not a fact."
